# Built on the BurmillaOS host by build.sh with system-docker.
# BASE_IMAGE is the os-zfs image the build ran in, which is already present
# locally, so system-docker does not need to pull anything and the userland
# runs against the same glibc it was compiled with.
ARG BASE_IMAGE=debian:trixie-slim
FROM ${BASE_IMAGE}

# Everything `make install DESTDIR=...` produced (minus kernel modules, see
# .dockerignore written by build.sh). Copying whole directories keeps the
# shared library symlinks intact, so there is no per-soname fix-up needed.
COPY . /

ENV PATH=$PATH:/usr/local/sbin:/usr/local/bin
ENV LD_LIBRARY_PATH=/usr/local/lib

RUN ldconfig

WORKDIR /
CMD []
ENTRYPOINT ["/usr/local/bin/entry.sh"]
